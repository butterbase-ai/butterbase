# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit it.

# ── Butterbase ───────────────────────────────────────────────────────────────
# Get an API key at https://butterbase.ai/dashboard → your app → Settings → API keys.
BUTTERBASE_API_KEY=bb_sk_replace_me
BUTTERBASE_APP_ID=app_replace_me
BUTTERBASE_API_URL=https://api.butterbase.ai/v1/app_replace_me

# ── Twitter / X (optional — only needed if you want to bake creds into local
# scripts instead of pasting them through Settings → Social accounts → "Use
# my own app"). The frontend wizard is the recommended path.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=

# ── Butter Support widget (optional — embeds the support chat widget for
# signed-in users). Set as an env var on the `widget-token` function:
#   manage_function update_env function_name=widget-token \
#     env='{"BUTTER_SUPPORT_WIDGET_SECRET":"ws_..."}'
# Get the secret from the butter-support console → Widget settings.
BUTTER_SUPPORT_WIDGET_SECRET=ws_replace_me
