{
  "name": "butter-support-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --mode widget",
    "build:widget": "vite build --mode widget",
    "preview": "vite preview",
    "zip": "node zip-dist.js",
    "deploy": "sh -c ': ${VITE_BUTTERBASE_SUBDOMAIN:?must be set to the target clone subdomain, e.g. wsgr-support} ${DEPLOY_APP_ID:?must be set to the target app id, e.g. app_pwnxp63j0p0b}' && npm run build && npm run zip"
  },
  "dependencies": {
    "@butterbase/sdk": "latest",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.0.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "react-router": "^7.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^2.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "archiver": "^7.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
