# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit it.

# ── Butterbase platform credentials ──────────────────────────────────────────
# Create an app at https://butterbase.ai, then generate a service key under
# your app → Settings → API keys.
BUTTERBASE_API_KEY=bb_sk_replace_me
BUTTERBASE_APP_ID=app_replace_me
BUTTERBASE_API_URL=https://api.butterbase.ai
BUTTERBASE_SUBDOMAIN=your-app-subdomain

# ── Internal RPC token ───────────────────────────────────────────────────────
# Shared secret used by widget-ingest / widget-followup / auto-reply-worker to
# call SupportTicketDO, by all callers to reach sync-ticket-artifact, and by the
# DO to verify service-call kicks. Generate a fresh random 64-char hex value:
#   openssl rand -hex 32
# Set the same value as an env var on every function that needs it.
INTERNAL_TOKEN=replace_me_with_openssl_rand_hex_32
